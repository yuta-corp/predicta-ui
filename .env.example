# Predicta frontend — variables d'environnement.
# Copiez ce fichier vers .env et remplissez les valeurs.
# .env est gitignoré : ne commitez jamais de clé.

# URL publique du site (sitemap, robots, Open Graph).
# Exemple : https://predicta.mg
NEXT_PUBLIC_SITE_URL=

# URL de l'API Predicta upstream (serveur uniquement).
# Ancien nom encore supporté : NEXT_PUBLIC_API_URL.
API_URL=

# Clé API d'une application enregistrée (table `applications`).
# Sert UNIQUEMENT côté serveur, dans le proxy /api/predicta/*.
# Ne jamais exposer cette clé au navigateur (pas de NEXT_PUBLIC_API_KEY).
API_KEY=

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Signature des webhooks Clerk (Clerk Dashboard → Webhooks → Signing secret).
CLERK_WEBHOOK_SIGNING_SECRET=

# Prisma ORM — chaîne de connexion PostgreSQL (Neon, Supabase, RDS…).
# Exemple Neon : postgresql://user:password@ep-xxx.region.aws.neon.tech/predicta?sslmode=require
DATABASE_URL=
