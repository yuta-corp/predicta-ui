# Predicta frontend — variables d'environnement.
# Copiez ce fichier vers .env et remplissez les valeurs.
# .env est gitignoré : ne commitez jamais de clé.

# URL de l'API Predicta upstream (serveur uniquement).
# Ancien nom encore supporté : NEXT_PUBLIC_API_URL.
API_URL=

# Clé API d'une application enregistrée (table `applications`).
# Sert UNIQUEMENT côté serveur, dans le proxy /api/predicta/*.
# Ne jamais exposer cette clé au navigateur (pas de NEXT_PUBLIC_API_KEY).
API_KEY=
