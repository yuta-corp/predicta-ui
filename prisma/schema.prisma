generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Utilisateur local, miroir des comptes Clerk (sync via webhook ou à la
/// demande dans les server actions). `id` = Clerk user ID. `username` est le
/// pseudo choisi par l'utilisateur (recherche d'amis via `searchUsers`).
model User {
  id                  String                 @id
  username            String?                @unique
  email               String?
  firstName           String?
  lastName            String?
  profileImageUrl     String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  sentFriendships     Friendship[]           @relation("Requester")
  receivedFriendships Friendship[]           @relation("Addressee")
  locationShare       LocationShare?
  shareViewers        LocationShareViewer[]  @relation("ShareAllowedTo")
  viewedShares        LocationShareViewer[]  @relation("ViewerOf")
  locationLinks       LocationShareLink[]

  @@map("users")
}

/// Demande d'ami : pending → accepted | declined. La contrainte unique
/// (requesterId, addresseeId) empêche les doublons dans un sens ; le sens
/// inverse est vérifié en application (une demande existe déjà si l'un des
/// deux a déjà un lien pending/accepted avec l'autre).
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

enum FriendshipStatus {
  pending
  accepted
  declined
}

/// Dernière position partagée (opt-in) d'un utilisateur. Une seule ligne par
/// utilisateur (upsert) ; la fraîcheur est évaluée sur `updatedAt` lors des
/// lectures (les positions plus vieilles que le TTL sont ignorées).
model LocationShare {
  userId    String   @id
  latitude  Float
  longitude Float
  accuracy  Float?
  /// Début de la session de partage courante (fixé au démarrage, jamais
  /// avancé par le rafraîchissement périodique de la position).
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("location_shares")
}

/// Autorisations « qui peut me voir » : une ligne par ami explicitement
/// autorisé à voir ma position. Absence de ligne = personne ne me voit.
/// Les lignes survivent à l'arrêt du partage : la sélection est mémorisée.
model LocationShareViewer {
  shareUserId  String
  viewerUserId String
  createdAt    DateTime @default(now())
  shareUser    User     @relation("ShareAllowedTo", fields: [shareUserId], references: [id], onDelete: Cascade)
  viewer       User     @relation("ViewerOf", fields: [viewerUserId], references: [id], onDelete: Cascade)

  @@id([shareUserId, viewerUserId])
  @@index([viewerUserId])
  @@map("location_share_viewers")
}

/// Lien de partage externe (option « partager par lien »). Le lien est secret
/// (token), mais sa consultation exige d'être authentifié chez Clerk.
model LocationShareLink {
  token     String    @id
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("location_share_links")
}